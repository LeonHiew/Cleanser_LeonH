[node name="Label2" type="Label" parent="CanvasLayer/TutorialPanel"]
layout_mode = 1
anchors_preset = -1
offset_left = 37.0
offset_top = 318.0
offset_right = 499.0
offset_bottom = 400.0
theme_override_font_sizes/font_size = 24
text = "each week settlers produce food and water
and contribute to the town militray and ingenuity

each settler consumes 1 food and water each week

Militray is ued to fight off bandit raids, if militray power is 
less than bandit power, you lose the raid and risk death

Ingenuity determines the chance for  an
event to be positive. at ingenuity 20 it is a 
50% chance
as ingenuity increases its luck gains exponentionally decress
"

